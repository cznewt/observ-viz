{
 "uid": "salt-job-view",
 "title": "Salt / Job View",
 "schemaVersion": 39,
 "version": 2,
 "editable": true,
 "tags": [
  "salt",
  "salt-observ-lib",
  "app-level"
 ],
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "type": "textbox",
    "name": "JID",
    "label": "JID",
    "query": "",
    "current": {
     "text": "",
     "value": ""
    },
    "description": "Empty = latest state job. Click a row in Recent jobs to set."
   },
   {
    "type": "textbox",
    "name": "Name",
    "label": "Job name",
    "query": "highstate",
    "current": {
     "text": "highstate",
     "value": "highstate"
    }
   }
  ]
 },
 "links": [
  {
   "title": "Salt Infrastructure",
   "type": "link",
   "icon": "dashboard",
   "url": "/d/salt-infrastructure",
   "keepTime": true,
   "targetBlank": false,
   "asDropdown": false,
   "includeVars": false,
   "tooltip": "Back to the jobs overview",
   "tags": []
  }
 ],
 "panels": [
  {
   "id": 10,
   "type": "table",
   "title": "Recent jobs (click a row to inspect)",
   "gridPos": {
    "h": 8,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "gedu-salt-pg"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "gedu-salt-pg"
     },
     "format": "table",
     "rawSql": "SELECT j.jid AS \"JID\", COALESCE(NULLIF(j.load->'arg'->>0,''),'highstate') AS \"Job\", j.load->>'fun' AS \"Function\", to_timestamp(substring(j.jid,1,14),'YYYYMMDDHH24MISS') AS \"Started\", (SELECT count(*) FROM salt_returns r WHERE r.jid = j.jid) AS \"Returns\" FROM jids j WHERE (load->>'fun' LIKE 'state.%' OR load->>'fun' LIKE 'runner.state.%') ORDER BY j.jid DESC LIMIT 50"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "filterable": true
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "JID"
      },
      "properties": [
       {
        "id": "links",
        "value": [
         {
          "title": "Inspect this job",
          "url": "/d/salt-job-view?var-JID=${__data.fields.JID}&var-Name=${__data.fields.Job}"
         }
        ]
       },
       {
        "id": "custom.width",
        "value": 220
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Started"
      },
      "properties": [
       {
        "id": "unit",
        "value": "dateTimeAsIso"
       },
       {
        "id": "custom.width",
        "value": 180
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Returns"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 100
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true
   }
  },
  {
   "id": 1,
   "type": "table",
   "title": "Job states",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "gedu-salt-pg"
   },
   "gridPos": {
    "h": 14,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "gedu-salt-pg"
     },
     "rawSql": "SELECT\n  key AS state,\n  (value->>'__run_num__')::int AS run,\n  CASE WHEN (value->>'result')::boolean IS NOT TRUE THEN 'failed'\n       WHEN value->'changes' IS NOT NULL AND value->'changes' != '{}'::jsonb THEN 'changed'\n       ELSE 'unchanged' END AS status,\n  round((value->>'duration')::numeric, 1) AS duration_ms,\n  value->>'comment' AS comment\nFROM salt_returns, jsonb_each(return::jsonb) AS kv(key, value)\nWHERE jid = COALESCE(NULLIF('$JID',''), (SELECT MAX(jid) FROM salt_returns WHERE fun LIKE 'state.%' OR fun LIKE 'runner.state.%')) AND jsonb_typeof(return::jsonb) = 'object' AND jsonb_typeof(value) = 'object'\nORDER BY run",
     "format": "table"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "filterable": true
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "status"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "failed": {
            "text": "failed",
            "color": "red"
           },
           "changed": {
            "text": "changed",
            "color": "orange"
           },
           "unchanged": {
            "text": "unchanged",
            "color": "green"
           }
          }
         }
        ]
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       },
       {
        "id": "custom.width",
        "value": 100
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "run"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 60
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "duration_ms"
      },
      "properties": [
       {
        "id": "unit",
        "value": "ms"
       },
       {
        "id": "custom.width",
        "value": 110
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "state"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 420
       }
      ]
     }
    ]
   },
   "options": {
    "footer": {
     "show": false
    },
    "sortBy": []
   }
  },
  {
   "id": 2,
   "type": "traces",
   "title": "Trace",
   "datasource": {
    "type": "tempo",
    "uid": "newt-tempo"
   },
   "gridPos": {
    "h": 14,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "tempo",
      "uid": "newt-tempo"
     },
     "query": "000000000000$JID",
     "queryType": "traceql"
    }
   ],
   "options": {},
   "description": "Pick a job in Recent jobs first (trace id = zero-padded jid)."
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Job duration \u2014 $Name",
   "datasource": {
    "type": "prometheus",
    "uid": "newt-mimir"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 22
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "newt-mimir"
     },
     "expr": "salt_job_duration{job_name=\"$Name\"}",
     "legendFormat": "{{id}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 4,
   "type": "table",
   "title": "Full return (jsonb)",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "gedu-salt-pg"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 22
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "gedu-salt-pg"
     },
     "rawSql": "SELECT jsonb_pretty(full_ret::jsonb) AS full_ret FROM salt_returns WHERE jid = COALESCE(NULLIF('$JID',''), (SELECT MAX(jid) FROM salt_returns WHERE fun LIKE 'state.%' OR fun LIKE 'runner.state.%')) LIMIT 1",
     "format": "table"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "cellOptions": {
       "type": "auto",
       "wrapText": true
      },
      "inspect": true
     }
    },
    "overrides": []
   },
   "options": {
    "cellHeight": "lg"
   }
  }
 ]
}