{
 "uid": "salt-job-view",
 "title": "Salt / Job View",
 "schemaVersion": 39,
 "version": 2,
 "editable": true,
 "tags": [
  "salt",
  "salt-observ-lib",
  "app-level"
 ],
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "JID",
    "label": "JID",
    "type": "query",
    "datasource": {
     "type": "grafana-postgresql-datasource",
     "uid": "gedu-salt-pg"
    },
    "query": {
     "refId": "PgVariableQuery",
     "rawSql": "SELECT DISTINCT jid AS __value FROM salt_returns WHERE fun LIKE 'state.%' OR fun LIKE 'runner.state.%' ORDER BY __value DESC LIMIT 100",
     "format": "table"
    },
    "refresh": 2,
    "sort": 0,
    "includeAll": false,
    "multi": false,
    "options": [],
    "current": {},
    "definition": "SELECT DISTINCT jid AS __value FROM salt_returns WHERE fun LIKE 'state.%' OR fun LIKE 'runner.state.%' ORDER BY __value DESC LIMIT 100"
   },
   {
    "name": "Name",
    "label": "Job",
    "type": "query",
    "datasource": {
     "type": "grafana-postgresql-datasource",
     "uid": "gedu-salt-pg"
    },
    "query": {
     "refId": "PgVariableQuery",
     "rawSql": "SELECT COALESCE(NULLIF(load->'arg'->>0,''),'highstate') AS __value FROM jids WHERE jid = '$JID'",
     "format": "table"
    },
    "refresh": 2,
    "sort": 0,
    "includeAll": false,
    "multi": false,
    "options": [],
    "current": {},
    "definition": "SELECT COALESCE(NULLIF(load->'arg'->>0,''),'highstate') AS __value FROM jids WHERE jid = '$JID'"
   },
   {
    "name": "traceID",
    "label": "traceID",
    "type": "query",
    "datasource": {
     "type": "grafana-postgresql-datasource",
     "uid": "gedu-salt-pg"
    },
    "query": {
     "refId": "PgVariableQuery",
     "rawSql": "SELECT LPAD(REPLACE('$JID','_',''), 32, '0') AS __value",
     "format": "table"
    },
    "refresh": 2,
    "sort": 0,
    "includeAll": false,
    "multi": false,
    "options": [],
    "current": {},
    "definition": "SELECT LPAD(REPLACE('$JID','_',''), 32, '0') AS __value"
   }
  ]
 },
 "links": [
  {
   "title": "Salt Jobs",
   "type": "link",
   "icon": "dashboard",
   "url": "/d/salt-jobs-overview",
   "keepTime": true,
   "targetBlank": false,
   "asDropdown": false,
   "includeVars": false,
   "tooltip": "Back to the jobs overview",
   "tags": []
  }
 ],
 "panels": [
  {
   "id": 1,
   "type": "table",
   "title": "Job states \u2014 $JID",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "gedu-salt-pg"
   },
   "gridPos": {
    "h": 14,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "gedu-salt-pg"
     },
     "rawSql": "SELECT\n  key AS state,\n  (value->>'__run_num__')::int AS run,\n  CASE WHEN (value->>'result')::boolean IS NOT TRUE THEN 'failed'\n       WHEN value->'changes' IS NOT NULL AND value->'changes' != '{}'::jsonb THEN 'changed'\n       ELSE 'unchanged' END AS status,\n  round((value->>'duration')::numeric, 1) AS duration_ms,\n  value->>'comment' AS comment\nFROM salt_returns, jsonb_each(return::jsonb) AS kv(key, value)\nWHERE jid = '$JID' AND jsonb_typeof(return::jsonb) = 'object' AND jsonb_typeof(value) = 'object'\nORDER BY run",
     "format": "table"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "filterable": true
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "status"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "failed": {
            "text": "failed",
            "color": "red"
           },
           "changed": {
            "text": "changed",
            "color": "orange"
           },
           "unchanged": {
            "text": "unchanged",
            "color": "green"
           }
          }
         }
        ]
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       },
       {
        "id": "custom.width",
        "value": 100
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "run"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 60
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "duration_ms"
      },
      "properties": [
       {
        "id": "unit",
        "value": "ms"
       },
       {
        "id": "custom.width",
        "value": 110
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "state"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 420
       }
      ]
     }
    ]
   },
   "options": {
    "footer": {
     "show": false
    },
    "sortBy": []
   }
  },
  {
   "id": 2,
   "type": "traces",
   "title": "Trace",
   "datasource": {
    "type": "tempo",
    "uid": "newt-tempo"
   },
   "gridPos": {
    "h": 14,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "tempo",
      "uid": "newt-tempo"
     },
     "query": "$traceID",
     "queryType": "traceql"
    }
   ],
   "options": {}
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Job duration \u2014 $Name",
   "datasource": {
    "type": "prometheus",
    "uid": "newt-mimir"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 14
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "newt-mimir"
     },
     "expr": "salt_job_duration{job_name=\"$Name\"}",
     "legendFormat": "{{id}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 4,
   "type": "table",
   "title": "Full return (jsonb)",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "gedu-salt-pg"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 14
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "gedu-salt-pg"
     },
     "rawSql": "SELECT jsonb_pretty(full_ret::jsonb) AS full_ret FROM salt_returns WHERE jid = '$JID' LIMIT 1",
     "format": "table"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "cellOptions": {
       "type": "auto",
       "wrapText": true
      },
      "inspect": true
     }
    },
    "overrides": []
   },
   "options": {
    "cellHeight": "lg"
   }
  }
 ]
}