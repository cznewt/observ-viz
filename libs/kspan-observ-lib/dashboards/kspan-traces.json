 "panels": [
  {
   "id": 1,
   "type": "traces",
   "title": "Kubernetes object events (kspan)",
   "datasource": {
    "type": "tempo",
    "uid": "newt-tempo"
   },
   "gridPos": {
    "h": 12,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "tempo",
      "uid": "newt-tempo"
     },
     "query": "{ resource.cluster =~ \"$cluster\" && name =~ \"(Deployment|Pod|ReplicaSet|StatefulSet|DaemonSet|Job|Service|Node)\\\\..*\" }",
     "queryType": "traceql",
     "limit": 50,
     "tableType": "traces"
    }
   ],
   "options": {}
  },
  {
   "id": 2,
   "type": "traces",
   "title": "All recent traces (kspan + salt jobs)",
   "datasource": {
    "type": "tempo",
    "uid": "newt-tempo"
   },
   "gridPos": {
    "h": 12,
    "w": 24,
    "x": 0,
    "y": 12
   },
   "targets": [
    {
     "refId": "B",
     "datasource": {
      "type": "tempo",
      "uid": "newt-tempo"
     },
     "query": "{ resource.cluster =~ \"$cluster\" }",
     "queryType": "traceql",
     "limit": 50,
     "tableType": "traces"
    }
   ],
   "options": {}
  }
 ]
