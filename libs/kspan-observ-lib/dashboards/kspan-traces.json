    "multi": false,
    "options": [
     {
      "text": "All",
      "value": ".*",
      "selected": true
     },
     {
      "text": "gedu-prg",
      "value": "gedu-prg",
      "selected": false
     },
     {
      "text": "newt-prg",
      "value": "newt-prg",
      "selected": false
     }
    ],
    "current": {
     "text": "All",
     "value": ".*",
     "selected": true
    }
   }
  ]
 },
